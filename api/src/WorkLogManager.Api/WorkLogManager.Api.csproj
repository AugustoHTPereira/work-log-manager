<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!--
      NU1903 audit note (see .claude/docs/padroes-desenvolvimento.md): AutoMapper is pinned at
      13.0.1, the last version released under the MIT license before AutoMapper switched
      to the commercial/RPL1.5 license starting at 15.0.0. The only versions that fix the
      known high-severity DoS advisory (GHSA-rvv3-g6hj-g44x, uncontrolled recursion on
      deeply-nested object graphs) are 15.1.1+/16.1.1+, which are not MIT-licensed. We
      accept this residual risk: this project's mapped types are flat DTOs/entities with
      no circular/self-referencing graphs, so the practical exploitability of the advisory
      here is effectively nil. Revisit if AutoMapper back-ports a fix to an MIT release, or
      if the project ever needs a paid Lucky Penny Software license anyway.
    -->
    <PackageReference Include="AutoMapper" Version="13.0.1" />
    <!--
      Bumped from 10.0.1 to the latest 10.x patch to pull in Microsoft.OpenApi >= 2.12.0,
      which fixes NU1903 (GHSA-v5pm-xwqc-g5wc, stack overflow on circular schema
      references) transitively. No source changes required.
    -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WorkLogManager.Application\WorkLogManager.Application.csproj" />
    <ProjectReference Include="..\WorkLogManager.Infrastructure\WorkLogManager.Infrastructure.csproj" />
  </ItemGroup>

</Project>
